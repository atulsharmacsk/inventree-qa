# Copy to .env and fill in InvenTree credentials.
# Target: LOCALHOST (http://localhost) or REMOTE (https://demo.inventree.org); URLs are mapped in shared/environments.ts.
ENV=LOCALHOST
# roles
SUPERUSER_USERNAME=
SUPERUSER_PASSWORD=
READER_USERNAME=
READER_PASSWORD=
# Non-staff user with Part view, add, and change.
ENGINEER_USERNAME=
ENGINEER_PASSWORD=