{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "paginated-category-tree-list.schema.json",
  "title": "PaginatedCategoryTreeList",
  "description": "Generated from InvenTree API 561 OpenAPI schema (https://github.com/inventree/schema/tree/main/export/561), components.schemas.PaginatedCategoryTreeList and CategoryTree",
  "type": "object",
  "required": [
    "count",
    "results"
  ],
  "properties": {
    "count": {
      "type": "integer"
    },
    "next": {
      "anyOf": [
        {
          "type": "string",
          "format": "uri"
        },
        {
          "type": "null"
        }
      ]
    },
    "previous": {
      "anyOf": [
        {
          "type": "string",
          "format": "uri"
        },
        {
          "type": "null"
        }
      ]
    },
    "results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CategoryTree"
      }
    }
  },
  "$defs": {
    "CategoryTree": {
      "type": "object",
      "description": "Serializer for PartCategory tree.",
      "properties": {
        "pk": {
          "type": "integer",
          "readOnly": true,
          "title": "ID"
        },
        "name": {
          "type": "string",
          "description": "Name",
          "maxLength": 100
        },
        "description": {
          "type": "string",
          "description": "Description (optional)",
          "maxLength": 250
        },
        "pathstring": {
          "type": "string",
          "title": "Path",
          "description": "Path",
          "maxLength": 250
        },
        "parent": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "tree_id": {
          "type": "integer",
          "readOnly": true
        },
        "level": {
          "type": "integer",
          "readOnly": true
        },
        "icon": {
          "type": "string",
          "description": "Icon (optional)",
          "maxLength": 100
        },
        "structural": {
          "type": "boolean",
          "description": "Parts may not be directly assigned to a structural category, but may be assigned to child categories."
        },
        "subcategories": {
          "type": "integer",
          "readOnly": true
        }
      },
      "required": [
        "level",
        "name",
        "pk",
        "subcategories",
        "tree_id"
      ]
    }
  }
}
