{
  "name": "automation",
  "version": "1.0.0",
  "description": "Playwright API tests for InvenTree",
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "typecheck": "tsc --noEmit",
    "lint:specs": "node ../shared/check-spec-layering.mjs tests",
    "report": "playwright show-report",
    "allure:generate": "allure generate allure-results --output allure-report --clean",
    "allure:open": "allure open allure-report --host 127.0.0.1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "ajv": "^8.20.0",
    "allure": "^3.22.1",
    "allure-playwright": "^3.14.0",
    "dotenv": "^18.0.9",
    "jszip": "^3.10.2",
    "typescript": "^7.0.2"
  }
}
