{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "types": [
      "node"
    ],
    // shared/ has no node_modules; resolve its type-only package imports from this project.
    "paths": {
      "@playwright/test": [
        "./node_modules/@playwright/test"
      ]
    }
  },
  "include": [
    "playwright.config.ts",
    "src/**/*.ts",
    "tests/**/*.ts",
    "../shared/**/*.ts"
  ]
}