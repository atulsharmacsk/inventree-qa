{
  "name": "inventree-ui-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright UI checks for InvenTree",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=ui",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report",
    "snapshot": "node scripts/snapshot.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "dotenv": "^18.0.9",
    "jszip": "^3.10.2",
    "typescript": "^7.0.2"
  }
}
